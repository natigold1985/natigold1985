{%- comment -%} FAQPage schema built automatically from <details><summary> in any page or blog article,
  so editing the Q&A in the Shopify editor keeps the structured data in sync. {%- endcomment -%}
{%- liquid
  assign jg_faq_src = ''
  if request.page_type == 'page'
    assign jg_faq_src = page.content
  elsif request.page_type == 'article'
    assign jg_faq_src = article.content
  elsif request.page_type == 'product'
    assign jg_faq_src = product.description
  endif
-%}
{%- if jg_faq_src contains '<summary' -%}
  {%- assign jg_chunks = jg_faq_src | split: '<summary' -%}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
  {%- for c in jg_chunks offset: 1 -%}
    {%- assign q = c | split: '</summary>' | first | split: '>' | slice: 1, 99 | join: '>' | strip_html | strip -%}
    {%- assign a = c | split: '</summary>' | last | split: '</details>' | first | strip_html | strip_newlines | strip -%}
    {"@type":"Question","name":{{ q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a | json }}}}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ]}
  </script>
{%- endif -%}
