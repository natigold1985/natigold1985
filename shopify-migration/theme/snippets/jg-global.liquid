{%- comment -%}
  Judith Gold – global brand layer (rendered once from layout/theme.liquid).
  - Brand fonts/colours, RTL tweaks
  - WhatsApp ordering instead of cart (no payment provider yet)
  - Floating WhatsApp button
  - LocalBusiness + FAQPage structured data (GEO/AEO)
  To edit the WhatsApp number: change jg_wa below (international format, digits only).
{%- endcomment -%}
{%- liquid
  assign jg_wa = '972547444478'
  assign jg_phone_display = '054-7444478'
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{--jg-plum:#6e2f6b;--jg-plum-dark:#4f1f4d;--jg-gold:#8c6825;--jg-cream:#fbf6f2;--jg-ink:#2d1a2c;--jg-wa:#1f8f4e}
  :root{--font-body--family:'Assistant',sans-serif;--font-heading--family:'Assistant',sans-serif;--font-subheading--family:'Assistant',sans-serif;--font-accent--family:'Assistant',sans-serif}
  body,button,input,select,textarea{font-family:'Assistant',sans-serif}
  h1,h2,h3,h4,h5,h6,.jg-serif{font-family:'Assistant',sans-serif!important;font-weight:700;letter-spacing:0}
  html[dir="rtl"] .text-left,html[dir="rtl"] [style*="text-align: left"]{text-align:right}

  /* --- No online payment yet: hide cart / buy buttons, order via WhatsApp --- */
  add-to-cart-component,.add-to-cart-button,.product-form-buttons,.shopify-payment-button,
  sticky-add-to-cart,quick-add-component,.quick-add,.quick-add__button,
  cart-icon,.header-actions__cart-icon,.header__icon--cart,a[href$="/cart"]{display:none!important}

  .jg-wa-order{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;
    padding:15px 22px;border-radius:14px;background:var(--jg-wa);color:#fff!important;
    font-weight:700;font-size:1.05rem;text-decoration:none;margin-block:14px;box-shadow:0 6px 18px rgba(31,143,78,.25)}
  .jg-wa-order:hover{filter:brightness(1.07)}
  .jg-wa-order svg{flex:none}
  .jg-trust-mini{list-style:none;padding:0;margin:0 0 10px;display:grid;gap:4px;font-size:.9rem;color:#3d3342}
  .jg-ask{display:inline-block;color:#6e2f6b;font-weight:600;font-size:.92rem;margin-bottom:14px;text-decoration:underline;text-underline-offset:3px}
  .jg-wa-note{font-size:.88rem;opacity:.75;margin:-4px 0 12px}
  .jg-wa-sticky{display:none}
  @media (max-width:749px){
    .jg-wa-sticky{display:flex;position:fixed;inset-inline:0;bottom:0;z-index:58;gap:10px;align-items:center;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #ece4ee;box-shadow:0 -8px 24px rgba(33,26,38,.08)}
    .jg-wa-sticky .jg-wa-order{margin:0;padding:13px 16px;font-size:1rem}
    .jg-wa-sticky strong{white-space:nowrap;font-size:1.15rem;color:#211a26}
    .template-product body,body.template-product{padding-bottom:76px}
  }
  .jg-wa-order.is-floating{position:fixed;inset-inline:12px;bottom:12px;width:auto;z-index:60;margin:0}

  .jg-wa-fab{position:fixed;bottom:18px;inset-inline-start:18px;z-index:55;width:58px;height:58px;border-radius:50%;
    display:grid;place-items:center;background:var(--jg-wa);color:#fff;box-shadow:0 8px 22px rgba(0,0,0,.22)}
  .jg-wa-fab:hover{transform:scale(1.06)}
  .template-product .jg-wa-fab{display:none}
</style>

{%- capture jg_wa_icon -%}<svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M16 .5C7.4.5.5 7.4.5 16c0 2.8.7 5.4 2 7.7L.4 31.6l8.1-2.1c2.2 1.2 4.7 1.9 7.5 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.5 16 .5zm0 28.3c-2.5 0-4.8-.7-6.8-1.8l-.5-.3-4.8 1.3 1.3-4.7-.3-.5a12.7 12.7 0 0 1-2-6.8C3.1 8.9 8.9 3.1 16 3.1S28.9 8.9 28.9 16 23.1 28.8 16 28.8z"/></svg>{%- endcapture -%}

{%- if request.page_type == 'product' -%}
  {%- capture jg_msg -%}היי יהודית, אשמח להזמין: {{ product.title }} ({{ product.price | divided_by: 100 }} ₪). קישור: {{ shop.url }}{{ product.url }}{%- endcapture -%}
  <div id="jg-wa-order-wrap" hidden>
    <a class="jg-wa-order" href="https://wa.me/{{ jg_wa }}?text={{ jg_msg | url_encode }}" target="_blank" rel="noopener">
      {{ jg_wa_icon }} להזמנה מהירה בוואטסאפ
    </a>
    <p class="jg-wa-note">יהודית תחזור אליך לאישור ההזמנה, תיאום תשלום ומשלוח. משלוח חינם מעל 199 ₪.</p>
    <ul class="jg-trust-mini"><li>✓ מוצר מקורי – משווקת מורשית ד״ר קליין</li><li>✓ משלוח 1–3 ימי עסקים</li><li>✓ החזרה תוך 14 יום (מוצר סגור)</li></ul>
    <a class="jg-ask" href="https://wa.me/{{ jg_wa }}?text={{ 'היי יהודית, יש לי שאלה על ' | append: product.title | url_encode }}" target="_blank" rel="noopener">לא בטוחה שזה מתאים לך? שאלי את יהודית ←</a>
  </div>
  <div class="jg-wa-sticky" aria-hidden="true">
    <strong>₪{{ product.price | divided_by: 100 }}</strong>
    <a class="jg-wa-order" tabindex="-1" href="https://wa.me/{{ jg_wa }}?text={{ jg_msg | url_encode }}" target="_blank" rel="noopener">{{ jg_wa_icon }} הזמנה בוואטסאפ</a>
  </div>
  <script>
    (function () {
      var wrap = document.getElementById('jg-wa-order-wrap');
      if (!wrap) return;
      // Place the WhatsApp button where the (hidden) buy buttons would be
      var anchor = document.querySelector('product-form-component, form[action*="/cart/add"], .product-form-buttons');
      if (anchor) {
        anchor.insertAdjacentElement('beforebegin', wrap);
        wrap.hidden = false;
      } else {
        wrap.hidden = false;
        wrap.querySelector('.jg-wa-order').classList.add('is-floating');
        document.body.appendChild(wrap);
      }
    })();
  </script>
{%- endif -%}

<a class="jg-wa-fab" href="https://wa.me/{{ jg_wa }}?text={{ 'היי יהודית, אשמח לייעוץ' | url_encode }}" target="_blank" rel="noopener" aria-label="שליחת הודעה ליהודית בוואטסאפ">{{ jg_wa_icon }}</a>
<script>document.body.classList.add('template-{{ request.page_type }}');</script>

