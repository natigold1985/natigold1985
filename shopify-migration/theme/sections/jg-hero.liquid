{%- comment -%} Judith Gold – hero, trust strip and Dr. Klein series. Markup/classes mirror the GitHub site; styles in assets/jg-site.css. All texts/images editable in the theme editor. {%- endcomment -%}
{{ 'jg-site.css' | asset_url | stylesheet_tag }}
{%- assign wa = section.settings.whatsapp | default: '972547444478' -%}
<div class="jg">
  <section class="hero" id="home">
    <div class="hero-content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hero-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero-title">{{ section.settings.title }}{% if section.settings.title2 != blank %}<br>{{ section.settings.title2 }}{% endif %}</h1>
      <div class="hero-lead">{{ section.settings.lead }}</div>
      <div class="hero-cta">
        {%- if section.settings.btn1_label != blank -%}<a class="btn btn-primary" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="btn btn-ghost" href="https://wa.me/{{ wa }}?text={{ section.settings.btn2_message | url_encode }}" target="_blank" rel="noopener"><svg viewBox="0 0 32 32" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M16 .5C7.4.5.5 7.4.5 16c0 2.8.7 5.4 2 7.7L.4 31.6l8.1-2.1c2.2 1.2 4.7 1.9 7.5 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.5 16 .5zm0 28.3c-2.5 0-4.8-.7-6.8-1.8l-.5-.3-4.8 1.3 1.3-4.7-.3-.5a12.7 12.7 0 0 1-2-6.8C3.1 8.9 8.9 3.1 16 3.1S28.9 8.9 28.9 16 23.1 28.8 16 28.8z"/></svg> {{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
      <ul class="hero-badges">
        {%- if section.settings.badge1 != blank -%}<li>{{ section.settings.badge1 }}</li>{%- endif -%}
        {%- if section.settings.badge2 != blank -%}<li>{{ section.settings.badge2 }}</li>{%- endif -%}
        {%- if section.settings.badge3 != blank -%}<li>{{ section.settings.badge3 }}</li>{%- endif -%}
      </ul>
    </div>
    <div class="hero-visual">
      <div class="hero-frame">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero-photo', alt: section.settings.image.alt, sizes: '(min-width: 990px) 370px, 88vw' }}
        {%- endif -%}
        {%- if section.settings.chip_title != blank -%}
          <div class="hero-chip"><strong>{{ section.settings.chip_title }}</strong><span>{{ section.settings.chip_text }}</span></div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="יתרונות">
    {%- for i in (1..4) -%}
      {%- capture k -%}trust{{ i }}_value{%- endcapture -%}
      {%- capture l -%}trust{{ i }}_label{%- endcapture -%}
      {%- if section.settings[k] != blank -%}<div><strong>{{ section.settings[k] }}</strong><span>{{ section.settings[l] }}</span></div>{%- endif -%}
    {%- endfor -%}
  </section>

  {%- if section.blocks.size > 0 -%}
  <section class="jg-sec lines lines-wrap" id="lines">
    <div class="section-head">
      {%- if section.settings.series_eyebrow != blank -%}<span class="eyebrow">{{ section.settings.series_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.series_title }}</h2>
      {%- if section.settings.series_text != blank -%}<p>{{ section.settings.series_text }}</p>{%- endif -%}
    </div>
    <div class="lines-grid">
      {%- for block in section.blocks -%}
        {%- assign sp = block.settings.product -%}
        {%- assign simg = block.settings.image | default: sp.featured_image -%}
        <a class="line-card" href="{{ block.settings.link | default: sp.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="line-media">
            {%- if simg -%}{{ simg | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- elsif settings.logo -%}{{ settings.logo | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- endif -%}
          </div>
          <span class="line-kicker">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </a>
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "יהודית גולד – פתיחה",
  "tag": "div",
  "class": "jg-hero-section",
  "settings": [
    { "type": "header", "content": "באנר פתיחה" },
    { "type": "text", "id": "eyebrow", "label": "כותרת קטנה", "default": "קוסמטיקה מקצועית · ד״ר קליין" },
    { "type": "text", "id": "title", "label": "כותרת ראשית", "default": "היופי שמתחיל" },
    { "type": "text", "id": "title2", "label": "כותרת ראשית – שורה 2", "default": "בעור בריא" },
    { "type": "richtext", "id": "lead", "label": "טקסט פתיחה", "default": "<p>יהודית גולד מביאה אליכם את הסדרות המקצועיות של <strong>ד״ר קליין</strong> – דרמו-קוסמטיקה מבוססת מחקר קליני ורכיבים פעילים, לתוצאות אמיתיות שנראות ומורגשות. ליווי אישי ומשלוח מהיר לכל הארץ.</p>" },
    { "type": "image_picker", "id": "image", "label": "תמונה" },
    { "type": "text", "id": "chip_title", "label": "תגית על התמונה – שם", "default": "יהודית גולד" },
    { "type": "text", "id": "chip_text", "label": "תגית על התמונה – טקסט", "default": "קוסמטיקאית · 20+ שנות ניסיון" },
    { "type": "text", "id": "btn1_label", "label": "כפתור ראשי – טקסט", "default": "לתכשירים שלנו" },
    { "type": "url", "id": "btn1_link", "label": "כפתור ראשי – קישור" },
    { "type": "text", "id": "btn2_label", "label": "כפתור וואטסאפ – טקסט", "default": "לדבר עם יהודית" },
    { "type": "text", "id": "btn2_message", "label": "כפתור וואטסאפ – הודעה מוכנה", "default": "היי יהודית, אשמח לייעוץ לפני רכישה" },
    { "type": "text", "id": "whatsapp", "label": "מספר וואטסאפ (בפורמט 972...)", "default": "972547444478" },
    { "type": "text", "id": "badge1", "label": "יתרון 1", "default": "משלוח מהיר לכל הארץ" },
    { "type": "text", "id": "badge2", "label": "יתרון 2", "default": "מוצרים מקוריים 100%" },
    { "type": "text", "id": "badge3", "label": "יתרון 3", "default": "ייעוץ אישי בוואטסאפ" },
    { "type": "header", "content": "פס אמון" },
    { "type": "text", "id": "trust1_value", "label": "1 – ערך", "default": "+35 שנות" },
    { "type": "text", "id": "trust1_label", "label": "1 – תיאור", "default": "מחקר ד״ר קליין" },
    { "type": "text", "id": "trust2_value", "label": "2 – ערך", "default": "100%" },
    { "type": "text", "id": "trust2_label", "label": "2 – תיאור", "default": "מקורי ומאושר" },
    { "type": "text", "id": "trust3_value", "label": "3 – ערך", "default": "20+ שנה" },
    { "type": "text", "id": "trust3_label", "label": "3 – תיאור", "default": "ניסיון בטיפוח העור" },
    { "type": "text", "id": "trust4_value", "label": "4 – ערך", "default": "14 יום" },
    { "type": "text", "id": "trust4_label", "label": "4 – תיאור", "default": "החזרה לפי חוק" },
    { "type": "header", "content": "סדרות" },
    { "type": "text", "id": "series_eyebrow", "label": "כותרת קטנה", "default": "הסדרות הטיפוליות" },
    { "type": "text", "id": "series_title", "label": "כותרת", "default": "סדרות ד״ר קליין" },
    { "type": "text", "id": "series_text", "label": "תיאור", "default": "קווי טיפוח מקצועיים, כל אחד עם התמחות ורכיבים פעילים משלו" }
  ],
  "blocks": [
    {
      "type": "series",
      "name": "סדרה",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "תמונה" },
        { "type": "text", "id": "title", "label": "שם הסדרה" },
        { "type": "textarea", "id": "text", "label": "תיאור" },
        { "type": "product", "id": "product", "label": "מוצר מייצג (תמונה וקישור)" },
        { "type": "url", "id": "link", "label": "קישור אחר (לא חובה)" }
      ]
    }
  ],
  "presets": [{ "name": "יהודית גולד – פתיחה" }]
}
{% endschema %}
