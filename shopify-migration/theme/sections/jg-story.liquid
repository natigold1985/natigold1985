    { "type": "text", "id": "treat_eyebrow", "label": "כותרת קטנה", "default": "המכון בחיפה" },
    { "type": "text", "id": "treat_title", "label": "כותרת", "default": "טיפולי פנים ואסתטיקה במכון בחיפה" },
    { "type": "richtext", "id": "treat_text", "label": "טקסט", "default": "<p>מעבר לחנות האונליין, יהודית מקבלת במכון בוורדיה סנטר לטיפולי פנים מקצועיים.</p><ul><li>ניקוי עור עמוק וטיפולי פנים</li><li>פילינגים וטיפולי חידוש</li><li>אנטי-אייג'ינג ומיצוק</li><li>טיפולי הבהרה ואקנה</li></ul>" },
    { "type": "text", "id": "treat_button", "label": "טקסט כפתור", "default": "לתיאום טיפול במכון" },
    { "type": "text", "id": "treat_message", "label": "הודעה מוכנה", "default": "היי יהודית, אשמח לתאם טיפול במכון" },
    { "type": "url", "id": "treat_page_link", "label": "קישור לעמוד הטיפולים" },
    { "type": "header", "content": "אודות" },
    { "type": "image_picker", "id": "about_image", "label": "תמונה" },
    { "type": "text", "id": "about_eyebrow", "label": "כותרת קטנה", "default": "אודות" },
    { "type": "text", "id": "about_title", "label": "כותרת", "default": "טיפוח בסטנדרט של זהב" },
    { "type": "richtext", "id": "about_text", "label": "טקסט", "default": "<p><strong>יהודית גולד</strong> היא קוסמטיקאית מקצועית ובעלת מכון לטיפולי אסתטיקה בחיפה.</p>" },
    { "type": "url", "id": "about_link", "label": "קישור לעמוד אודות" },
    { "type": "header", "content": "שאלות נפוצות" },
    { "type": "text", "id": "faq_title", "label": "כותרת", "default": "שאלות נפוצות" },
    { "type": "header", "content": "יצירת קשר" },
    { "type": "text", "id": "contact_title", "label": "כותרת", "default": "הצטרפו למועדון יהודית גולד" },
    { "type": "text", "id": "contact_text", "label": "טקסט", "default": "טיפים לטיפוח, עדכונים על מבצעים רשמיים וסדרות חדשות של ד״ר קליין." },
    { "type": "text", "id": "phone", "label": "טלפון", "default": "054-7444478" },
    { "type": "text", "id": "email", "label": "אימייל", "default": "judithgold10@gmail.com" },
    { "type": "text", "id": "instagram", "label": "אינסטגרם", "default": "@judithgold04" },
    { "type": "text", "id": "address", "label": "כתובת", "default": "ורדיה סנטר, חיפה" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "שאלה ותשובה",
