{%- comment -%} Judith Gold – consultation CTA, clinic treatments, about, contact and FAQ (with FAQPage schema). Editable in the theme editor. {%- endcomment -%}
{{ 'jg-site.css' | asset_url | stylesheet_tag }}
{%- assign wa = section.settings.whatsapp | default: '972547444478' -%}
{%- capture wa_icon -%}<svg viewBox="0 0 32 32" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M16 .5C7.4.5.5 7.4.5 16c0 2.8.7 5.4 2 7.7L.4 31.6l8.1-2.1c2.2 1.2 4.7 1.9 7.5 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.5 16 .5zm0 28.3c-2.5 0-4.8-.7-6.8-1.8l-.5-.3-4.8 1.3 1.3-4.7-.3-.5a12.7 12.7 0 0 1-2-6.8C3.1 8.9 8.9 3.1 16 3.1S28.9 8.9 28.9 16 23.1 28.8 16 28.8z"/></svg>{%- endcapture -%}

<div class="jg">
  <section class="section chat-cta" id="chat" aria-label="ייעוץ אישי">
    <div class="chat-box">
      <span class="eyebrow">{{ section.settings.chat_eyebrow }}</span>
      <h2>{{ section.settings.chat_title }}</h2>
      {{ section.settings.chat_text }}
      <a class="btn btn-chat" href="https://wa.me/{{ wa }}?text={{ section.settings.chat_message | url_encode }}" target="_blank" rel="noopener">{{ wa_icon }} {{ section.settings.chat_button }}</a>
    </div>
  </section>

  <section class="section treatments" id="treatments">
    <div class="treatments-media">
      {%- if section.settings.treat_image -%}{{ section.settings.treat_image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: section.settings.treat_image.alt }}{%- endif -%}
    </div>
    <div class="treatments-text">
      <span class="eyebrow">{{ section.settings.treat_eyebrow }}</span>
      <h2>{{ section.settings.treat_title }}</h2>
      <div class="jg-rte">{{ section.settings.treat_text }}</div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://wa.me/{{ wa }}?text={{ section.settings.treat_message | url_encode }}" target="_blank" rel="noopener">{{ section.settings.treat_button }}</a>
        {%- if section.settings.treat_page_link != blank -%}<a class="btn btn-ghost" href="{{ section.settings.treat_page_link }}">לכל הטיפולים</a>{%- endif -%}
      </div>
    </div>
  </section>

  <section class="section about" id="about">
    <div class="about-visual">
      {%- if section.settings.about_image -%}{{ section.settings.about_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'about-photo', alt: section.settings.about_image.alt }}{%- endif -%}
    </div>
    <div class="about-text">
      <span class="eyebrow">{{ section.settings.about_eyebrow }}</span>
      <h2>{{ section.settings.about_title }}</h2>
      {{ section.settings.about_text }}
      {%- if section.settings.about_link != blank -%}<a class="btn btn-primary" href="{{ section.settings.about_link }}">עוד על יהודית</a>{%- endif -%}
    </div>
  </section>

  <section class="section newsletter" id="contact">
    <div class="newsletter-box">
      <h2>{{ section.settings.contact_title }}</h2>
      <p>{{ section.settings.contact_text }}</p>
      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="כתובת אימייל" autocomplete="email" required aria-label="כתובת אימייל">
        <button type="submit" class="btn btn-primary">הצטרפו עכשיו</button>
        <div class="jg-consent">
          <label><input type="checkbox" required> קראתי ואני מסכימה ל<a href="/pages/תקנון-ותנאי-שימוש">תקנון</a> ול<a href="/pages/מדיניות-פרטיות">מדיניות הפרטיות</a></label>
          <label><input type="checkbox" name="contact[accepts_marketing]" value="true" required> אני מאשרת קבלת דיוור ועדכונים במייל; ניתן להסיר בכל עת</label>
        </div>
        {%- if form.posted_successfully? -%}<p class="newsletter-note" role="status">תודה! נרשמת למועדון.</p>{%- endif -%}
      {%- endform -%}
      <div class="contact-details">
        <a href="tel:{{ section.settings.phone | remove: '-' }}">📞 {{ section.settings.phone }}</a>
        <a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{{ wa_icon }} וואטסאפ</a>
        <a href="mailto:{{ section.settings.email }}">✉️ {{ section.settings.email }}</a>
        {%- if section.settings.instagram != blank -%}<a href="https://www.instagram.com/{{ section.settings.instagram | remove: '@' }}" target="_blank" rel="noopener">📷 {{ section.settings.instagram }}</a>{%- endif -%}
        <span>📍 {{ section.settings.address }}</span>
        <span>🕘 חנות אונליין 24/7</span>
      </div>
    </div>
  </section>

  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
  <section class="section" id="faq">
    <div class="section-head">
      <span class="eyebrow">שאלות ותשובות</span>
      <h2>{{ section.settings.faq_title }}</h2>
      <p>תשובות קצרות וברורות</p>
    </div>
    <div class="faq">
      {%- for block in faqs -%}
        <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div>{{ block.settings.answer }}</div></details>
      {%- endfor -%}
    </div>
    <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
      {%- for block in faqs -%}
      {"@type":"Question","name":{{ block.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]}
    </script>
  </section>
  {%- endif -%}
</div>

{% stylesheet %}
  .jg .chat-box p,.jg .about-text p{margin-bottom:16px}
  .jg .jg-rte ul{list-style:none;display:grid;gap:8px;margin:0 0 24px}
  .jg .jg-rte li{padding-inline-start:26px;position:relative;color:var(--ink-soft);font-weight:500}
  .jg .jg-rte li::before{content:"✓";position:absolute;inset-inline-start:0;color:var(--gold);font-weight:800}
  .jg .jg-rte p{color:var(--muted);margin-bottom:16px}
  .jg .chat-box .btn{margin-top:4px}
  .jg .newsletter-form .btn{border-radius:9px}
  .jg .jg-consent{flex-basis:100%;display:grid;gap:6px;justify-items:center;font-size:.84rem;color:#cabfce;margin-top:6px}
  .jg .jg-consent label{display:inline-flex;gap:8px;align-items:center}
  .jg .jg-consent a{text-decoration:underline}
{% endstylesheet %}

{% schema %}
{
  "name": "יהודית גולד – תוכן",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "whatsapp", "label": "מספר וואטסאפ (בפורמט 972...)", "default": "972547444478" },
    { "type": "header", "content": "ייעוץ אישי" },
