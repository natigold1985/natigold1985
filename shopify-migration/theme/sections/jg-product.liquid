{%- comment -%} Judith Gold – product page in the GitHub-site style: gallery with thumbnails, price, WhatsApp ordering, trust points, description/FAQ, related products. Catalog only (no cart). {%- endcomment -%}
{{ 'jg-site.css' | asset_url | stylesheet_tag }}
{%- assign wa = section.settings.whatsapp | default: '972547444478' -%}
{%- liquid
  assign kicker = ''
  for t in product.tags
    assign first = t | slice: 0
    if 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789' contains first
      assign kicker = t
      break
    endif
  endfor
  assign main_coll = nil
  for c in product.collections
    unless c.handle == 'frontpage' or c.handle == 'all'
      assign main_coll = c
      break
    endunless
  endfor
  assign intro = product.description | split: '<h3' | first
  assign rest = product.description | remove_first: intro
-%}
{%- capture msg -%}היי יהודית, אשמח להזמין: {{ product.title }} ({{ product.price | divided_by: 100 }} ₪). קישור: {{ shop.url }}{{ product.url }}{%- endcapture -%}
{%- capture wa_icon -%}<svg viewBox="0 0 32 32" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M16 .5C7.4.5.5 7.4.5 16c0 2.8.7 5.4 2 7.7L.4 31.6l8.1-2.1c2.2 1.2 4.7 1.9 7.5 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.5 16 .5zm0 28.3c-2.5 0-4.8-.7-6.8-1.8l-.5-.3-4.8 1.3 1.3-4.7-.3-.5a12.7 12.7 0 0 1-2-6.8C3.1 8.9 8.9 3.1 16 3.1S28.9 8.9 28.9 16 23.1 28.8 16 28.8z"/></svg>{%- endcapture -%}

<script type="application/ld+json">{{ product | structured_data }}</script>

<div class="jg">
  <section class="jg-sec jg-pdp">
    <nav class="jg-crumbs jg-crumbs--dark" aria-label="פירורי לחם">
      <a href="{{ routes.root_url }}">דף הבית</a> /
      {%- if main_coll %} <a href="{{ main_coll.url }}">{{ main_coll.title }}</a> /{% endif %}
      <span>{{ product.title }}</span>
    </nav>

    <div class="jg-pdp__grid">
      <div class="pd-gallery">
        <div class="pd-main">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 1100 | image_tag: id: 'jgMainImg', loading: 'eager', fetchpriority: 'high', alt: product.featured_image.alt | default: product.title, sizes: '(min-width: 990px) 560px, 92vw' }}
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="pd-thumbs">
            {%- for img in product.images -%}
              <button type="button" class="pd-thumb{% if forloop.first %} active{% endif %}" data-src="{{ img | image_url: width: 1100 }}" data-alt="{{ img.alt | default: product.title | escape }}" aria-label="תמונה {{ forloop.index }}">
                {{ img | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pd-info">
        {%- if kicker != blank -%}<span class="product-line-kicker">{{ kicker }}</span>{%- endif -%}
        <h1 class="jg-pdp__title">{{ product.title }}</h1>
        <p class="jg-pdp__brand">ד״ר קליין · Dr. Klein</p>
        <div class="pd-price">₪{{ product.price | divided_by: 100 }} <span class="jg-vat">כולל מע״מ</span></div>
        <div class="pd-desc">{{ intro }}</div>

        <a class="jg-wa-order" href="https://wa.me/{{ wa }}?text={{ msg | url_encode }}" target="_blank" rel="noopener">{{ wa_icon }} להזמנה מהירה בוואטסאפ</a>
        <p class="jg-wa-note">יהודית תחזור אליך לאישור ההזמנה, תיאום תשלום ומשלוח. משלוח חינם מעל 199 ₪.</p>
        <ul class="jg-points">
          <li><strong>מקורי 100%</strong><span>משווקת מורשית ד״ר קליין</span></li>
          <li><strong>1–3 ימי עסקים</strong><span>משלוח לכל הארץ</span></li>
          <li><strong>14 יום</strong><span>החזרה למוצר סגור</span></li>
        </ul>
        <a class="jg-ask" href="https://wa.me/{{ wa }}?text={{ 'היי יהודית, יש לי שאלה על ' | append: product.title | url_encode }}" target="_blank" rel="noopener">לא בטוחה שזה מתאים לך? שאלי את יהודית ←</a>

        {%- if rest != blank -%}<div class="jg-pdp__details">{{ rest }}</div>{%- endif -%}
      </div>
    </div>
  </section>

  <section class="jg-sec">
    <div class="section-head">
      <span class="eyebrow">משלימים את השגרה</span>
      <h2>{% if main_coll %}עוד מ{{ main_coll.title }} ומוצרים משלימים{% else %}מוצרים משלימים{% endif %}</h2>
    </div>
    <div class="product-grid">
      {%- assign shown = 0 -%}
      {%- assign seen = product.id | append: ',' | prepend: ',' -%}
      {%- if main_coll -%}
        {%- for p in main_coll.products -%}
          {%- assign key = p.id | append: ',' | prepend: ',' -%}
          {%- if shown < 4 -%}{%- unless seen contains key -%}
            {%- render 'jg-product-card', product: p, wa: wa -%}
            {%- assign shown = shown | plus: 1 -%}{%- assign seen = seen | append: key -%}
          {%- endunless -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- for p in collections.all.products -%}
        {%- assign key = p.id | append: ',' | prepend: ',' -%}
        {%- if shown < 4 -%}{%- unless seen contains key -%}
          {%- render 'jg-product-card', product: p, wa: wa -%}
          {%- assign shown = shown | plus: 1 -%}{%- assign seen = seen | append: key -%}
        {%- endunless -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <div class="jg-wa-sticky">
    <strong>₪{{ product.price | divided_by: 100 }}</strong>
    <a class="jg-wa-order" href="https://wa.me/{{ wa }}?text={{ msg | url_encode }}" target="_blank" rel="noopener">{{ wa_icon }} הזמנה בוואטסאפ</a>
  </div>
</div>

<script>
  (function () {
    var main = document.getElementById('jgMainImg');
    document.querySelectorAll('.jg .pd-thumb').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!main) return;
        main.removeAttribute('srcset');
        main.src = b.dataset.src;
        main.alt = b.dataset.alt;
        document.querySelectorAll('.jg .pd-thumb').forEach(function (x) { x.classList.toggle('active', x === b); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "יהודית גולד – מוצר",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "whatsapp", "label": "מספר וואטסאפ (בפורמט 972...)", "default": "972547444478" }
  ]
}
{% endschema %}
