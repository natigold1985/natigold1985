{%- comment -%} Judith Gold – category pills + product grid, mirroring the GitHub site's cards. Ordering via WhatsApp (catalog only). {%- endcomment -%}
{{ 'jg-site.css' | asset_url | stylesheet_tag }}
{%- assign wa = section.settings.whatsapp | default: '972547444478' -%}
{%- assign coll = section.settings.collection | default: collections.all -%}
<div class="jg">
  {%- if section.settings.show_categories -%}
  <section class="jg-sec" id="categories">
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.cat_eyebrow }}</span>
      <h2>{{ section.settings.cat_title }}</h2>
      <p>{{ section.settings.cat_text }}</p>
    </div>
    <div class="cat-grid">
      <a class="cat-card active" href="{{ routes.all_products_collection_url }}"><span>הכל</span></a>
      {%- for c in section.settings.categories -%}<a class="cat-card" href="{{ c.url }}"><span>{{ c.title }}</span></a>{%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  <section class="jg-sec" id="products">
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="product-grid">
      {%- for product in coll.products limit: section.settings.limit -%}
        {%- render 'jg-product-card', product: product, wa: wa -%}
      {%- endfor -%}
    </div>
    {%- if coll.products_count > section.settings.limit -%}
      <p style="text-align:center;margin-top:34px"><a class="btn btn-ghost" href="{{ coll.url }}">לכל המוצרים</a></p>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "יהודית גולד – מוצרים",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "whatsapp", "label": "מספר וואטסאפ (בפורמט 972...)", "default": "972547444478" },
    { "type": "checkbox", "id": "show_categories", "label": "הצגת קטגוריות", "default": true },
    { "type": "text", "id": "cat_eyebrow", "label": "קטגוריות – כותרת קטנה", "default": "לפי צורך" },
    { "type": "text", "id": "cat_title", "label": "קטגוריות – כותרת", "default": "הקטגוריות שלנו" },
    { "type": "text", "id": "cat_text", "label": "קטגוריות – תיאור", "default": "מצאו את הטיפוח המתאים בדיוק לעור שלכם" },
    { "type": "collection_list", "id": "categories", "label": "קטגוריות להצגה", "limit": 12 },
    { "type": "text", "id": "eyebrow", "label": "מוצרים – כותרת קטנה", "default": "החנות" },
    { "type": "text", "id": "title", "label": "מוצרים – כותרת", "default": "המוצרים שלנו" },
    { "type": "text", "id": "text", "label": "מוצרים – תיאור", "default": "מבחר תכשירי ד״ר קליין המקצועיים, ישירות אליכם" },
    { "type": "collection", "id": "collection", "label": "קטגוריה להצגה (ריק = כל המוצרים)" },
    { "type": "range", "id": "limit", "label": "מספר מוצרים", "min": 4, "max": 24, "step": 1, "default": 18 }
  ],
  "presets": [{ "name": "יהודית גולד – מוצרים" }]
}
{% endschema %}
